# Font & Geometry
font = "JetBrainsMono NFM SemiBold"
font-size = 16
width = 500
height = 250
border-width = 2
outline-width = 0
padding-top = 20
padding-bottom = 20
padding-left = 20
padding-right = 20
result-spacing = 15
num-results = 4

# High Contrast Catppuccin Mocha Colors
background-color = #000000CC
border-color = #CBA6F7
text-color = #CDD6F4
prompt-color = #CBA6F7
input-color = #CDD6F4
selection-color = #CBA6F7
selection-match-color = #F9E2AF
default-result-color = #CDD6F4

# Prompt & Matching
prompt-text = " "
fuzzy-match = true
require-match = false
hide-cursor = false
