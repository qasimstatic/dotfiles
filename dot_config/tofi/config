# Font
font = "Monaspace Neon NF"
font-size = 15

# Window dimensions and padding
width = 600
height = 400
border-width = 2
outline-width = 0
padding-top = 20
padding-bottom = 20
padding-left = 20
padding-right = 20

# Colors (Catppuccin Mocha)
background-color = #000000CC
text-color = #CDD6F4
prompt-color = #BAC2DE
placeholder-color = #7F849C
input-color = #CDD6F4
selection-color = #CBA6F7
selection-match-color = #000000
default-result-color = #CDD6F4

# Prompt
prompt-text = " "

# Matching
fuzzy-match = true
require-match = false
hide-cursor = false
